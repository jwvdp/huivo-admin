{
  "name": "@huivo-admin/server",
  "type": "module",
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "scripts": {
    "dev": "wrangler dev --env local --inspector-port 9231",
    "tsc": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "deploy": "wrangler deploy --env production",
    "auth": "bunx auth generate --config src/lib/better-auth.ts --output src/db/schemas/auth.ts --yes",
    "push": "drizzle-kit push --config src/db/drizzle.config.local.ts --force",
    "db:clean": "drizzle-kit push --config src/db/drizzle.clean.config.ts --force",
    "db:seed": "bun run src/db/seeds/index.ts",
    "db:reset": "bun db:clean && bun push && bun db:seed",
    "test": "vitest",
    "type": "wrangler types && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.3.0",
    "@hono/zod-validator": "^0.7.6",
    "@libsql/client": "^0.17.3",
    "@scalar/hono-api-reference": "^0.10.13",
    "better-auth": "^1.6.9",
    "drizzle-orm": "^1.0.0-rc.1",
    "hono": "^4.12.16"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.15.2",
    "@types/node": "^25.6.0",
    "drizzle-kit": "^1.0.0-rc.1",
    "vitest": "^4.1.5"
  }
}
