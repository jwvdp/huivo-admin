{
  "name": "huivo-admin",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "clean": "rm -rf node_modules .turbo .wrangler .tanstack .vercel .next dist build out",
    "dev": "turbo run dev tsc",
    "build": "turbo run build",
    "type": "turbo run type",
    "push": "cd apps/server && bun push",
    "deploy": "turbo run deploy",
    "prepare": "husky",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "devDependencies": {
    "@manypkg/cli": "^0.25.1",
    "husky": "^9.1.7",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "tsx": "^4.21.0",
    "turbo": "^2.9.9",
    "typescript": "6.0.3",
    "ultracite": "7.6.3",
    "wrangler": "^4.87.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.13"
}
