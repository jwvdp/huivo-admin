{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "tsc": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "type": {
      "dependsOn": ["^type"]
    },
    "build": {
      "dependsOn": ["^type"]
    },
    "deploy": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
